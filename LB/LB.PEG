program = WS (function WS)+ WS

function = type WS name WS "(" WS parameters? WS ")" WS scope

statement = decl
          / assign_stmt
          / if
          / while
          / label_stmt
          / scope
          / statements

statements = return
          / break
          / continue
          / goto
          / unary_stmt
          / call_stmt

label_stmt = label WS

goto = "goto" WS label WS

# call as a standalone statement must swallow its own trailing
# whitespace/comments, same as every other statement kind — "call" itself
# (below) stays bare since it's also used inside expressions.
call_stmt = call WS

call = name WS "(" WS (expression (WS "," WS expression)*)? WS ")"

unary_stmt = variable WS incdec WS

incdec = "++" / "--"

index = "[" WS expression WS "]"

array_access = variable (WS index)+

args = expression (WS "," WS expression)*

# VAR <- EXPR, per GRAMMAR.md's "VAR <- EXP" simplification. Covers plain
# assignment, array-element writes/reads, array/tuple allocation, and
# length in one production.
assign_stmt = lExpr WS "<-" WS rExpr WS

lExpr = array_access / variable

rExpr = newArrayExpr / newTupleExpr / lenExpr / array_access / expression

# ex. myArr <- new Array(5)
newArrayExpr = "new" WS "Array" WS "(" WS args WS ")"

# ex. t <- new Tuple(2)
newTupleExpr = "new" WS "Tuple" WS "(" WS args WS ")"

# ex. capacity <- length ptr 0 / length ptr myVar / length ptr fooBar()
# "_" (same-line whitespace) keeps an omitted dim from swallowing the next
# statement across a newline — see "_" below.
lenExpr = "length" WS variable (_ operand)?

unary = variable WS uop

uop = "!" / "&" /"--" / "++"

parameters = parameter (WS "," WS parameter)*

parameter = type WS variable

# ex. int64 myVar1
decl = type WS variable (WS "," WS variable)* WS

while = "while" WS "(" WS expression WS ")" WS label WS label WS

if = "if" WS "(" WS expression WS ")" WS label WS label WS

bop = "+" / "-" / "*" / "/" / "%" / "&" / "|" / "^" / "<<" / ">>"

cop = "==" / "!=" / "<=" / ">=" / "=" / "<" / ">"

type = void / arraytype / tupletype / codetype / int64

codetype = "code"

void = "void"

int64 = "int64"

tupletype = "tuple"

# int64[]  int64[][]  int64[][][]  — must precede int64 in "type" so the
# trailing brackets aren't left dangling and unparsed.
arraytype = int64 (WS "[" WS "]")+

scope = "{" WS (statement WS)* "}"

# "_" (not WS) for the optional trailing expression: it can't cross a
# newline, so an omitted return value can never eat the next statement.
return = "return" (_ expression)? WS

break = "break" WS

continue = "continue" WS

# A condition (if/while) is just an expression: boolean literal, comparison,
# or arithmetic — one optional comparison sits on top of an arithmetic chain.
expression = arith (WS cop WS arith)?

arith = operand (WS bop WS operand)*

operand = number
        / string
        / boolean
        / call
        / variable
        / unary

variable = ~r"[a-zA-Z_][a-zA-Z0-9_]*"

number = ~r"[+-]?[0-9]+(_[0-9]+)*"

string = ~r'"([^"\\]|\\.)*"'

name = ~r"[a-zA-Z_][a-zA-Z0-9_]*"

boolean = true / false

true = "true"

false = "false"

label = ":" name

# Insignificant whitespace AND comments — matches anywhere statements,
# arguments, or declarations are separated. Crosses newlines freely, so a
# standalone comment line (leading a scope, between functions, trailing a
# call statement) is always absorbed, not just whitespace.
WS = WS0 (COMMENTS WS0)*

WS0 = ~r"\s*"

# Same-line-only whitespace. Never crosses a newline, unlike WS — kept
# separate deliberately so an omitted optional trailing value (return's
# expression, length's dim) can never reach onto the next statement.
_ = ~r"[ \t]*"

COMMENTS = "//" ~r"[^\n]*"
